rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /admins/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /sessions/{sessionId} {
      // Anyone with the link can view the gallery session
      allow read: if true;

      // Any signed-in user can create a gallery
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // Gallery owner can update or close/reopen the gallery
      allow update, delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || !('ownerUid' in resource.data));

      match /uploads/{uploadId} {
        // Anyone with the gallery link can view uploaded photos and videos
        allow read: if true;

        // Anyone with the link can upload to the gallery as long as the gallery is active
        allow create: if request.resource.data.name is string
          && request.resource.data.contentType is string
          && request.resource.data.url is string;

        allow update: if false;

        // Gallery owner can delete uploaded media
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
