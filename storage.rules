rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /sessions/{sessionId}/{fileName} {
      allow read: if true;
      allow create: if firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.active == true
        && request.resource.size > 0
        && request.resource.size <= 209715200
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow update: if false;
      allow delete: if isAdmin()
        && firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
    }
  }
}