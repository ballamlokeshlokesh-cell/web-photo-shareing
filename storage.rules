rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sessions/{sessionId}/{fileName} {
      // Anyone with the link can view gallery media
      allow read: if true;

      // Anyone can upload media up to 200 MB per file
      allow create: if request.resource.size > 0
        && request.resource.size <= 209715200;

      allow update: if false;

      // Allow deletion by signed-in users
      allow delete: if request.auth != null;
    }
  }
}
